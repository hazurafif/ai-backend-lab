{
  "weather": {
    "url": "http://localhost:8090/mcp",
    "transport": "streamable_http",
    "headers": {
      "Authorization": "Bearer your-gofastmcp-token"
    }
  },
  "quiz": {
    "url": "http://127.0.0.1:8091/mcp",
    "transport": "streamable_http"
  },
  "docs-search": {
    "url": "https://docs.langchain.com/mcp",
    "transport": "streamable_http"
  },
  "local-cli": {
    "command": "/path/to/gofastmcp-tool",
    "args": ["serve"],
    "transport": "stdio",
    "env": {
      "MY_TOOL_API_KEY": "xxx"
    }
  }
}
