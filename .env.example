# --- Agent model ---
# Any provider:model supported by LangChain init_chat_model (openai:, anthropic:, google_genai:, ...)
DEEPAGENTS_MODEL=openai:gpt-4o-mini
# For a custom OpenAI-compatible endpoint (e.g. opencode.ai/zen/go/v1):
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional agent tweaks
# INTERRUPT_ON_JSON={"edit_file": true}
# SYSTEM_PROMPT=You are...

# --- Persistence (Postgres) ---
# DSN in the format postgresql+psycopg://user:pass@host:5432/dbname
# If unset: in-memory checkpointer + store (dev only, data lost on restart)
DATABASE_URI=

# --- MCP servers (gofastmcp) ---
# Either inline JSON ...
# MCP_SERVERS_JSON={"weather":{"url":"http://localhost:8090/mcp","transport":"streamable_http"},"cli-tool":{"command":"gofastmcp-tool","args":["serve"],"transport":"stdio"}}
# ... or a file (see mcp_servers.json.example)
# MCP_SERVERS_FILE=mcp_servers.json

# --- API ---
SECRET_KEY=change-me-in-production
CORS_ORIGINS=*
