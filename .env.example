# --- Agent model ---
# Optional. Provider:model string (e.g. "openai:gpt-4o-mini"). When unset,
# the default `llm` connection's `extra.model` is used instead. The app
# always starts; until one of the two exists, chats return 503 with
# instructions (configure the connection in-app, no restart needed).
# DEEPAGENTS_MODEL=openai:gpt-4o-mini
# For a custom OpenAI-compatible endpoint (e.g. opencode.ai/zen/go/v1), the
# base URL + key belong on the saved llm connection (POST /connections), not
# here:
#   POST /connections {"name": "zen", "kind": "llm",
#       "base_url": "https://opencode.ai/zen/go/v1", "api_token": "sk-...",
#       "extra": {"model": "openai:deepseek-v4-flash"}, "is_default": true}
# ANTHROPIC_API_KEY=sk-ant-...

# Optional agent tweaks
# INTERRUPT_ON_JSON={"edit_file": true}
# SYSTEM_PROMPT=You are...

# --- Persistence (Postgres) ---
# DSN in the format postgresql://user:pass@host:5432/dbname (psycopg conninfo or postgresql:// URL)
# Note: the SQLAlchemy-style postgresql+psycopg:// prefix is NOT accepted here.
# If unset: in-memory checkpointer + store (dev only, data lost on restart)
DATABASE_URI=

# --- MCP servers (gofastmcp) ---
# Either inline JSON ...
# MCP_SERVERS_JSON={"weather":{"url":"http://localhost:8090/mcp","transport":"streamable_http"},"cli-tool":{"command":"gofastmcp-tool","args":["serve"],"transport":"stdio"}}
# ... or a file (see mcp_servers.json.example)
# MCP_SERVERS_FILE=mcp_servers.json
# Per-call timeout (seconds) for the MCP tools proxy (POST /mcp/tools/call)
# MCP_TOOL_CALL_TIMEOUT=60

# --- Web search (SearXNG, self-hosted) ---
# Start the instance: docker compose up -d searxng (JSON API enabled in searxng/settings.yml)
# Unset SEARXNG_URL -> web_search tool not registered at all.
SEARXNG_URL=http://localhost:8092
# Master switch; per-request override: {"enable_search": false} in /chat or {"enableSearch": false} in /api/chat
SEARXNG_ENABLED=true
# SEARXNG_MAX_RESULTS=5
# SEARXNG_TIMEOUT=10

# --- Shell execution (execute tool) ---
# Opt-in! Enables the agent's built-in `execute` tool to run arbitrary host
# shell commands (LocalShellBackend). Unrestricted & irreversible - dev/trusted
# environments only. Recommended: INTERRUPT_ON_JSON={"execute": true} for
# human approval, and never on a shared/production server.
EXECUTE_ENABLED=false
# Per-user shell workspace root (execute mode): file tools AND the shell
# agree on real files under <WORKSPACE_ROOT>/<user_id>/ — a named volume in
# compose, so the repo stays clean and users stay isolated. Barehand runs
# may need a writable path, e.g. WORKSPACE_ROOT=./workspaces
# WORKSPACE_ROOT=/workspaces
# Cap on per-command timeout (seconds) the execute tool may request
# EXECUTE_MAX_TIMEOUT=3600
# Give shell commands access to the server's environment variables (incl. secrets).
# With false (default) the shell has an EMPTY env: no PATH -> `python`/`uv` are
# not found even though they are installed. Set true for a usable shell:
#   export PATH=... workarounds inside execute are no longer needed.
# EXECUTE_INHERIT_ENV=true
# Runtime override: PUT /settings (DB) wins over these at any time.

# --- Connection resolution ---
# When false (default), missing DB connections are a loud error: the agent
# LLM / KB embeddings never silently use .env credentials. Runtime override:
# PUT /settings {"connections": {"fallback_env": true}}
# CONNECTION_FALLBACK_ENV=false

# --- Chat file uploads ---
# Files posted to /chat and /api/chat (multipart `files`) are saved under
# UPLOADS_DIR/<username>/ (relative to the server cwd = the agent's workspace
# when EXECUTE_ENABLED=true) and the agent manipulates them with its own
# tools (e.g. `pdftotext` for PDFs). Filenames are sanitized, size-capped.
# UPLOADS_DIR=./uploads
# MAX_UPLOAD_SIZE_MB=25

# --- Knowledge base (RAG) ---
# Vector store: `docker compose up -d weaviate` (port 8093).
# Unset -> KB uploads/search return 503 and the agent has no KB tool.
WEAVIATE_URL=http://localhost:8093
# WEAVIATE_API_KEY=...
# Embeddings: uses OPENAI_API_KEY above; model + optional custom base URL.
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_BASE_URL=https://opencode.ai/zen/go/v1
# Matryoshka truncation for text-embedding-3 models (3x cheaper storage, minor recall loss)
# EMBEDDINGS_DIMENSIONS=1024
# BM25F field weights for Weaviate hybrid search (keyword stage: boost paths/titles)
# KB_BM25_PROPERTY_WEIGHTS={"path": 2.0}
# Reranking: retrieve broad (KB_RERANK_CANDIDATES) -> cross-encoder -> top-k.
# Local CPU option (flashrank, model ~4MB downloaded on first use):
# KB_RERANK_MODEL=ms-marco-MiniLM-L-12-v2
# KB_RERANK_CANDIDATES=20
# Query rewriting (LLM call before retrieval for vague queries; opt-in)
# KB_QUERY_REWRITE=false
# KB_REWRITE_MODEL=               # defaults to DEEPAGENTS_MODEL
# KB_REWRITE_MIN_LENGTH=8         # shorter queries are left untouched
# KB_MAX_FILE_SIZE_MB=25
# KB_ALLOWED_EXTENSIONS=.md,.txt,.pdf,.docx,.csv,.html,.json,.py,.js,.ts,.go,.rs,.java,.sql,.yml,.yaml,.xml
# KB_CHUNK_SIZE=1000
# KB_CHUNK_OVERLAP=200
# KB_MAX_UPLOAD_BATCH=100
# KB_HYBRID_ALPHA=0.5
# Per-user storage quota (MB across all KBs)
# KB_QUOTA_MB=500
# Zip upload guards: max entries + max total uncompressed size (zip-bomb protection)
# KB_ZIP_MAX_ENTRIES=500
# KB_ZIP_MAX_TOTAL_MB=100

# --- API ---
SECRET_KEY=change-me-in-production
CORS_ORIGINS=*

# Login brute-force protection (in-memory sliding window, per client IP + username)
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW=900

# --- Default admin (seeded on first start when the users store is empty) ---
# Change these before any shared deployment!
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=admin
